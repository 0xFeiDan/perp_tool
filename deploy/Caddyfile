{
    # Caddy's admin API remains inside the container only.
    admin off
}

# TLS is terminated by Tailscale Serve before this loopback-only proxy.
# Do not publish Caddy directly on the public internet.
http://:80 {
    encode zstd gzip

    # This service handles order intents, not uploads.
    request_body {
        max_size 1MB
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    reverse_proxy backend:8790 {
        # Caddy overwrites this at the only ingress boundary.  The backend
        # accepts it only when TRUST_PROXY_HEADERS=true in Docker deployment.
        header_up X-Real-IP {remote_host}
        flush_interval -1
        transport http {
            read_timeout 30s
            write_timeout 30s
        }
    }
}
