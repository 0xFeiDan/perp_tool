# Stored on Ubuntu as /etc/lighter/mt5-readonly.env (chmod 600), never copied
# into the Docker core .env.  Use an Investor Password, not a master password.
MT5_READONLY_ENABLED=true
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_READONLY_LOGIN=
MT5_READONLY_PASSWORD=
MT5_READONLY_SERVER=
MT5_READONLY_TIMEOUT_MS=60000
# A distinct 32+ character token shared only with backend/.env.
MT5_SIDECAR_TOKEN=
# Wine Python installation containing MetaTrader5, FastAPI and Uvicorn.
MT5_WINDOWS_PYTHON=/opt/lighter/mt5-python/python.exe
WINE_BIN=/usr/bin/wine64
WINEPATH_BIN=/usr/bin/winepath
