# Never commit a real .env file. Keep this file backend-only and use separate,
# trade-only API credentials with withdrawals disabled.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTROL_PLANE_TOKEN=
SESSION_MINUTES=30
# Limits incorrect and correct CONTROL_PLANE_TOKEN submissions per source
# before a short-lived authenticated session exists.
LOGIN_ATTEMPTS_PER_10_MINUTES=5
# Global, backend-enforced kill switch. It may be false while real API keys and
# live market data are configured; previews still work but no order is sent.
TRADING_ENABLED=false
# If true, any process with TRADING_ENABLED=true must have a reachable
# PostgreSQL DATABASE_URL. Docker Compose derives the URL from its separately
# stored PostgreSQL variables; local read-only development may leave it empty.
DURABLE_EXECUTION_REQUIRED=true
DATABASE_URL=
# Portfolio display start date. Current balances and positions are fetched on
# demand once the corresponding exchange account credentials are configured.
PORTFOLIO_START_DATE=2026-07-21
ORDER_INTENT_TTL_SECONDS=30
# Human confirmation needs a small window; the server still rejects a changed
# buy-one/sell-one price or an unavailable order book. Allowed range: 100-10000.
MAX_QUOTE_AGE_MS=5000
# Keep false on a local HTTP page. Set true only after HTTPS is terminated by a
# reverse proxy on your own domain, then set the exact domain in the lists.
PUBLIC_HTTPS=false
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:8790,http://localhost:8790
# Set true only when Caddy is the sole route to this private backend and
# overwrites X-Real-IP. Leave false for direct local Uvicorn development.
TRUST_PROXY_HEADERS=false
# A cryptographic HttpOnly session is sufficient behind Tailscale/Caddy. Set
# true only for a stable direct-client IP environment; mobile/tailnet path
# changes otherwise invalidate the session.
BIND_SESSION_TO_IP=false

# Global rule: each venue below stays locked until its own *_LIVE_TRADING=true.
# The service refuses to boot live trading without CONTROL_PLANE_TOKEN (32+ chars).

# Lighter: create a dedicated Lighter API key for this bot.
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_STREAM_URL=wss://mainnet.zklighter.elliot.ai/stream
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# ETH perpetual is market 0. The live API metadata is loaded at startup.
LIGHTER_MARKET_INDEX=0
LIGHTER_LIVE_TRADING=false

# Hyperliquid mainnet: API wallet private key and the account address it trades for.
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_API_WALLET_PRIVATE_KEY=
HYPERLIQUID_LIVE_TRADING=false
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Binance USD-M Futures MAINNET only. Use a Futures TRADE key restricted to your
# server IP. Do not enable spot, withdrawals, universal transfer or sub-account admin.
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_LIVE_TRADING=false
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/ws

# MT5 is never a trading venue in this system. Enable this only in the isolated
# Ubuntu/Wine sidecar after logging in with an Investor Password, never a master
# password. These direct settings are for the Wine sidecar process only; do not
# place an MT5 investor password in the Docker core's backend/.env.
MT5_READONLY_ENABLED=false
MT5_TERMINAL_PATH=
MT5_READONLY_LOGIN=
MT5_READONLY_PASSWORD=
MT5_READONLY_SERVER=
MT5_READONLY_TIMEOUT_MS=60000
# Core-to-sidecar transport. Leave all four empty for local direct development.
# Production: set the Unix socket and a separate 32+ character token; the
# investor password remains in /etc/lighter/mt5-readonly.env on Ubuntu.
MT5_SIDECAR_URL=
MT5_SIDECAR_UNIX_SOCKET=
MT5_SIDECAR_TOKEN=
MT5_SIDECAR_TIMEOUT_SECONDS=5

# No bot-level quantity or notional caps are applied. Lighter's own minimum-size,
# margin and risk checks still apply.
MAX_FOLLOW_REPRICES_PER_MINUTE=20
